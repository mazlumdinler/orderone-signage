# Copy this file to .env for local development.
# On Railway, set these as project Variables instead (see README.md).

PORT=3000

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Created automatically on first run if no admin user exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Where the SQLite database and uploaded images are stored.
# On Railway this should point into your mounted Volume, e.g. /data
DB_PATH=./data/signage.db
UPLOAD_DIR=./data/uploads
